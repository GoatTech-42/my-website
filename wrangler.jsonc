{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".public-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {},
  "build": {
    "command": "node prepare-public-assets.mjs",
    "cwd": "."
  }
}
