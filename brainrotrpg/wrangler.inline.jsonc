{
  "name": "brainrotrpg",
  "main": "src/inline-worker.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPAIGN",
        "class_name": "Campaign"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Campaign"
      ]
    }
  ],
  "build": {
    "command": "node prepare-inline-assets.mjs"
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.webp"
      ],
      "fallthrough": true
    }
  ]
}
